# ==============================================================================
# Auto Content Pipeline - Environment Variables
# ==============================================================================

# --- Core Credentials (Required) ---
# Google Gemini API Key (for Scriptwriting, Health-Check, and Gemini TTS)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Pixabay API Key (for high-resolution vertical 9:16 stock imagery)
# Obtain from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# --- OpenMontage Extended Tool Configuration (Optional) ---
# If using additional upstream OpenMontage media providers:
# FAL_KEY=your_fal_api_key
# ELEVENLABS_API_KEY=your_elevenlabs_key
# OPENAI_API_KEY=your_openai_key
